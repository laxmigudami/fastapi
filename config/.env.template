# Environment Configuration Template
# Copy this file to dev.env, staging.env, or prod.env and fill in values

# API Configuration
BASE_URL_APP=http://localhost:8000
API_VERSION=v1

# Database Configuration
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=fastapi
DATABASE_USERNAME=postgres

# Test Database
TEST_DATABASE_NAME=fastapi_test

# Authentication
SECRET_KEY=your_secret_key_here_generate_with_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Test Configuration
PYTEST_WORKERS=auto
TEST_TIMEOUT=300
PARALLEL_TESTS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/test.log

# Feature Flags
ENABLE_TEST_GENERATION=true
ENABLE_ALLURE_REPORTING=false
ENABLE_COVERAGE_REPORTS=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1
